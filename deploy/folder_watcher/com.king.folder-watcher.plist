<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.king.folder-watcher</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/KING</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>folder_watcher_service.py</string>
    <string>run</string>
    <string>--config</string>
    <string>tools/FOLDER_WATCHER_CONFIG.md</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
