{
  "name": "ares-desktop",
  "version": "0.1.0",
  "description": "Ares desktop client",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.ares.desktop",
    "productName": "Ares",
    "directories": {
      "output": "release"
    }
  }
}
