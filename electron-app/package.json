{
  "name": "ares-desktop",
  "version": "0.1.0",
  "description": "Ares desktop client",
  "main": "src/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "set ELECTRON_DEV=1 && wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "build:server": "cd .. && pyinstaller ares-server.spec --noconfirm --clean",
    "dist": "npm run build && electron-builder",
    "package": "npm run build && npm run build:server && electron-builder --win"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.ares.desktop",
    "productName": "Ares",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/**"
    ],
    "extraResources": [
      {
        "from": "../dist/ares-server",
        "to": "ares-server"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Ares-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
